# Cadena de conexion de Postgres (Neon, Supabase, o local)
DATABASE_URL=postgresql://usuario:password@ep-algo.neon.tech/neondb?sslmode=require

# Genera uno con: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Codigo de acceso para registrarse como admin (RH) o visualizador. Cambialo del valor de prueba.
ACCESS_CODE=181010

# En local deja "false". En Render (HTTPS) ponlo en "true".
COOKIE_SECURE=false

# En local: http://localhost:4000
# En Render: la URL que te asigne, ej. https://tu-app.onrender.com
CLIENT_ORIGIN=http://localhost:4000
APP_URL=http://localhost:4000

PORT=4000

# Opcional: solo si quieres que "olvide mi contrasena" mande correos reales.
# Si los dejas vacios, el enlace se imprime en la consola/logs.
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=
